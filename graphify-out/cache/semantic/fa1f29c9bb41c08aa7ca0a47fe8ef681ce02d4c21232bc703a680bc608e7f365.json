{"nodes": [{"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_tracking_stufen", "label": "Tracking-Stufen (intake_only, with_amount, complete)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Stufe beschreibt ausschliesslich die gewuenschte Dokumentationstiefe; keine Stufe wird als medizinisch besser, sicherer oder empfehlenswerter dargestellt."}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_intake_only", "label": "Stufe: Nur Einnahme", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_with_amount", "label": "Stufe: Mit Menge", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_complete", "label": "Stufe: Vollstaendig", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_routinegruppe", "label": "Routinegruppe und Sammelbestaetigung", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_titration", "label": "Dosisaenderungen und Titration", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_pk_readiness", "label": "PK-Readiness-Check", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Live-Blutspiegel-Funktion wird nicht allein durch die Stufe freigeschaltet; der Check liefert genau einen Zustand: verfuegbar, Angaben fehlen oder nicht unterstuetzt \u2014 es wird keine Ersatzkurve erzeugt."}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_menge_nicht_getrackt", "label": "Leere Dosis bedeutet 'Menge nicht getrackt'", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leere Dosis und Einheit bedeuten ausdruecklich nicht null Milligramm und keine ausgefallene Einnahme; unbekannte Mengen werden nie geschaetzt und unterbrechen die Simulationskurve."}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_stufenwechsel", "label": "Wechsel der Tracking-Stufe", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Upgrade uebernimmt vorhandene Daten, Downgrade loescht weder Produktdetails noch Historie; explizites Entfernen bleibt eine separate bestaetigungspflichtige Aktion."}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_bruchmengen", "label": "Bruchmengen als exakte Dezimalwerte", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_produkt_und_bestand", "label": "Optionaler Bereich Produkt & Bestand", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verpackungsgroesse und Anfangsbestand werden erst nach aktivem Opt-in 'Bestand mitverfolgen' abgefragt."}, {"id": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_bestandspeptide_complete", "label": "Bestehende Peptid-Eintraege erhalten 'complete'", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Damit kein bestehendes Feature verschwindet, bekommen Altdaten zunaechst die Stufe complete und werden nicht erneut durch den Wizard gezwungen."}], "edges": [{"source": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_tracking_stufen", "target": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_intake_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_tracking_stufen", "target": "docs_superpowers_specs_2026_07_25_my_stack_tracking_depth_design_with_amount", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-25-my-stack-tracking-depth-des