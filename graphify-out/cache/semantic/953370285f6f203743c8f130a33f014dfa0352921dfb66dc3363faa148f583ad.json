 "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_settings_tabelle", "label": "settings", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_client_rendering", "label": "Client-seitiges Template-Rendering", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Templates sind deterministisch, deshalb rendert der Browser die Vorschau und exportiert sie bei Freigabe per Canvas als PNG; Vorschau ist das Endprodukt und kein Rendering-Server noetig."}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_compliance_guardrails", "label": "Compliance-Guardrails der Peptid-Nische", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keine Heilversprechen, keine Dosierungsempfehlungen, keine medizinischen Claims; im Prompt verankert und zusaetzlich als Validierungsschicht mit Tests abgesichert."}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_review_workflow", "label": "Review-Workflow (Queue, Editor, Verwaltung)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_kostenkniff_ein_call", "label": "Ein Claude-Call pro Thema x Sprache", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ein Call liefert alle Kanalvarianten als strukturiertes JSON; ein 5-Themen-Batch in DE+EN kostet damit nur zehn Calls im Cent-Bereich."}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_pg_cron_auto_batch", "label": "pg_cron Auto-Batch mit Zeitplanpruefung", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pg_cron feuert in festem Takt und die Function prueft den Zeitplan aus settings, damit Zeitplan-Aenderungen sofort wirken ohne Cron-Job neu zu registrieren."}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_eigenes_supabase_projekt", "label": "Eigenes Supabase-Projekt fuer das Studio", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marketing-Tooling bleibt von Produktions-Nutzerdaten getrennt, keine RLS-Verflechtung."}, {"id": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_zod_validierung", "label": "Zod-Validierung mit einem Retry", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-06-marketing-content-studio-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_generate_batch", "target": "docs_superpowers_specs_2026_07_06_marketing_content_studio_design_topics_tabelle", "relation": "references", "confidence": "EXTRACTED", "confidence_s