{"nodes": [{"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_wertekarte", "label": "Karte 'Deine Werte'", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_haelften_vergleich", "label": "Kalenderhaelften-Vergleich der Metriken", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_kfa_invertierung", "label": "Umgekehrte Verbesserungsrichtung fuer KFA", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Niedrigere KFA-Werte gelten in dieser Verlaufsdarstellung als Verbesserung; daraus wird ausdruecklich keine medizinische Bewertung oder Zielzone abgeleitet."}, {"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_statusfarben", "label": "Statusfarben und Pfeilrichtungen", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nur Pfeil und Veraenderungswert sind farbig; Pfeil und Vorzeichen transportieren die Richtung zusaetzlich, damit die Bedeutung nicht allein von Farbe abhaengt."}, {"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_mindestdaten", "label": "Mindestdaten und Leerzustaende je Metrik", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_blutwertecard_entfernt", "label": "Entfernung der Fortschritt-BlutwerteCard", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Die Karte zeigt statt Einzelwerten den Durchschnitt der neueren Haelfte; Gewicht bleibt aussen vor, weil es bereits die Standard-Chart-Metrik ist, und die eigenstaendige Blutwerte-Seite bleibt unangetastet."}], "edges": [{"source": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_wertekarte", "target": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_haelften_vergleich", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_haelften_vergleich", "target": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_kfa_invertierung", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_haelften_vergleich", "target": "docs_superpowers_specs_2026_07_17_fortschritt_werteuebersicht_design_mindestdaten", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-07-17-fortschritt-werteuebersicht-design.md", "source_location": null, "weight": 1.0}, {"source": "doc